{
  "name": "matanot",
  "private": true,
  "version": "2.0.0",
  "description": "Matanot: personalized interactive surprise sites delivered by link. Landing page, order wizard with live sketch, and the surprise engine.",
  "type": "module",
  "author": "Shmuel Levy",
  "scripts": {
    "dev": "vite",
    "build": "npm run pages && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "cross-env E2E_TARGET=legacy playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "pages": "vite-node scripts/gen-pages.tsx"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~5.8",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
